FROM python:3.12-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-media-rag.txt requirements-youtube-rag.txt ./
RUN pip install --no-cache-dir -r requirements-youtube-rag.txt
COPY media_rag media_rag
COPY youtube_rag youtube_rag
COPY media_rag_app.py youtube_rag_app.py ./
RUN useradd --create-home --uid 10001 app
USER app
ENV PYTHONUNBUFFERED=1
CMD ["streamlit", "run", "youtube_rag_app.py", "--server.address", "0.0.0.0", "--server.port", "8504", "--server.enableCORS", "true", "--server.enableXsrfProtection", "true", "--server.allowedHosts", "localhost", "--server.allowedHosts", "127.0.0.1", "--browser.gatherUsageStats", "false"]
