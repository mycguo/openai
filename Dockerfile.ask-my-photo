FROM python:3.12-slim-bookworm
WORKDIR /app
COPY requirements-media-rag.txt requirements-ask-my-photo.txt ./
RUN pip install --no-cache-dir -r requirements-ask-my-photo.txt
COPY media_rag media_rag
COPY photo_rag photo_rag
COPY ask_my_photo_app.py .
RUN useradd --create-home --uid 10001 app
USER app
ENV PYTHONUNBUFFERED=1
CMD ["streamlit", "run", "ask_my_photo_app.py", "--server.address", "0.0.0.0", "--server.port", "8505", "--server.maxUploadSize", "15", "--server.enableCORS", "true", "--server.enableXsrfProtection", "true", "--server.allowedHosts", "localhost", "--server.allowedHosts", "127.0.0.1", "--browser.gatherUsageStats", "false"]
